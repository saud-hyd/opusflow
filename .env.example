# Example environment variables
# Copy this file to .env and fill in your actual values

# OpenAI API Key
OPENAI_API_KEY=your-key

# Database Configuration
DATABASE_URL=postgresql://opusflow:opusflow@localhost:5432/opusflow

# Weaviate Vector Database
WEAVIATE_URL=http://localhost:8080

# Unstructured.io API (for PDF/Excel/Image extraction)
UNSTRUCTURED_API_KEY=your-unstructured-api-key
UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general
UNSTRUCTURED_ENABLED=false

# Email Configuration (for negotiation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com

# Slack Integration (Optional)
SLACK_BOT_TOKEN=optional
SLACK_ENABLED=false

# n8n Workflow Automation
N8N_WEBHOOK_BASE=https://your-n8n-cloud.app.n8n.cloud
N8N_WEBHOOK_SECRET=optional-bearer-token

# Intelligence Reporting (Optional)
INTELLIGENCE_EMAIL=leaders@example.com

# Pricing Configuration
CUSTOMER_MARKUP_PERCENT=0.20
VAT_RATE=0.19

# Negotiation Configuration
DEFAULT_DISCOUNT_RATE=0.08
LEAD_TIME_REDUCTION_DAYS=5
NEGOTIATION_ACCEPT_THRESHOLD=85
NEGOTIATION_REJECT_THRESHOLD=60
