{
  "name": "Intelligence Scheduler - Daily Analysis",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule: Daily 2 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger (Demo)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        250,
        460
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "run_type",
              "name": "run_type",
              "type": "string",
              "value": "={{ $node.name === 'Manual Trigger (Demo)' ? 'manual' : 'scheduled' }}"
            },
            {
              "id": "timestamp",
              "name": "started_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "id": "merge-triggers",
      "name": "Merge Triggers",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        470,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/run-intelligence",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"time_range_days\": 180 }",
        "options": {
          "timeout": 30000
        }
      },
      "id": "run-intelligence",
      "name": "Run Intelligence Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        690,
        380
      ]
    },
    {
      "parameters": {
        "functionCode": "const data = { ...$json };\nconst getTop = (arr = [], fallback) => Array.isArray(arr) && arr.length ? arr[0] : fallback;\nconst defaultRisk = { title: 'No critical risks', description: '' };\nconst defaultOpp = { title: 'No opportunities', description: '' };\ndata.top_risk = getTop(data.critical_risks, defaultRisk);\ndata.top_opportunity = getTop(data.cost_opportunities, defaultOpp);\ndata.generated_at = data.generated_at || new Date().toISOString();\nreturn [data];"
      },
      "id": "enrich-results",
      "name": "Enrich Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.critical_risks }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "check-success",
      "name": "Analysis Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        910,
        380
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "slack_message",
              "name": "slack_message",
              "type": "string",
              "value": "\ud83e\udde0 *Daily Intelligence Report*\\n\\n\ud83d\udcca *Summary*\\n\u2022 Critical Risks: {{ $json.critical_risks.length }}\\n\u2022 Cost Opportunities: {{ $json.cost_opportunities.length }}\\n\u2022 Suppliers Analyzed: {{ $json.supplier_rankings.length }}\\n\\n\ud83d\udea8 *Top Risk*\\n{{ $json.critical_risks[0]?.title || 'No critical risks' }}\\n{{ $json.critical_risks[0]?.description || '' }}\\n\\n\ud83d\udca1 *Top Opportunity*\\n{{ $json.cost_opportunities[0]?.title || 'No opportunities found' }}\\n{{ $json.cost_opportunities[0]?.description || '' }}\\n\\n\ud83d\udcc8 View detailed report in dashboard\\n_Generated at {{ $json.generated_at }}_"
            },
            {
              "id": "email_subject",
              "name": "email_subject",
              "type": "string",
              "value": "Intelligence Update - {{ $json.generated_at }}"
            },
            {
              "id": "email_body",
              "name": "email_body",
              "type": "string",
              "value": "Daily intelligence summary:\\nTop Risk: {{ $json.top_risk.title }}\\nTop Opportunity: {{ $json.top_opportunity.title }}\\nTotal Risks: {{ $json.critical_risks.length }}\\nTotal Opportunities: {{ $json.cost_opportunities.length }}"
            }
          ]
        }
      },
      "id": "format-success-message",
      "name": "Format Success Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        1130,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/demo",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"text\": \"{{ $json.slack_message }}\" }",
        "options": {
          "retryOnFail": true,
          "maxRetries": 2
        }
      },
      "id": "notify-success",
      "name": "Slack: Report Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1350,
        280
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "error_message",
              "name": "slack_message",
              "type": "string",
              "value": "\u26a0\ufe0f *Intelligence Analysis Failed*\\n\\nThe daily intelligence report could not be generated.\\n\\nError: {{ $json.error || 'Unknown error' }}\\nTimestamp: {{ $now.toISO() }}\\n\\nPlease check the system logs."
            }
          ]
        }
      },
      "id": "format-error-message",
      "name": "Format Error Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        1130,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/demo",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"text\": \"{{ $json.slack_message }}\" }",
        "options": {
          "retryOnFail": true,
          "maxRetries": 2
        }
      },
      "id": "notify-error",
      "name": "Slack: Alert Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1350,
        480
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "send",
        "email": "leaders@opusflow.ai",
        "subject": "={{ $json.email_subject }}",
        "message": "={{ $json.email_body }}",
        "options": {}
      },
      "id": "intel-email",
      "name": "Email: Strategy",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1380,
        420
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "log_message",
              "name": "log_message",
              "type": "string",
              "value": "Intelligence run completed at {{ $json.generated_at }}"
            },
            {
              "id": "log_time",
              "name": "logged_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "id": "intel-log",
      "name": "Log Intelligence Run",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1600,
        320
      ]
    }
  ],
  "connections": {
    "Schedule: Daily 2 AM": {
      "main": [
        [
          {
            "node": "Merge Triggers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger (Demo)": {
      "main": [
        [
          {
            "node": "Merge Triggers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Triggers": {
      "main": [
        [
          {
            "node": "Run Intelligence Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Intelligence Analysis": {
      "main": [
        [
          {
            "node": "Enrich Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analysis Successful?": {
      "main": [
        [
          {
            "node": "Format Success Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Error Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Success Message": {
      "main": [
        [
          {
            "node": "Slack: Report Ready",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email: Strategy",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log Intelligence Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error Message": {
      "main": [
        [
          {
            "node": "Slack: Alert Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich Results": {
      "main": [
        [
          {
            "node": "Analysis Successful?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "intelligence",
      "id": "scheduled-analysis"
    },
    {
      "name": "opusflow",
      "id": "opusflow-core"
    }
  ],
  "pinData": {},
  "versionId": "1"
}